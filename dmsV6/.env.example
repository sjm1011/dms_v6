# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/dms
# 也可改用 PGHOST、PGPORT、PGDATABASE、PGUSER、PGPASSWORD。
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=wfDB1
PGUSER=wfcch
PGPASSWORD=24922000wfcch
# DMS_STORAGE_ROOT 用於 dmsV6 新上傳檔案；相對路徑以 dmsV6 執行目錄為基準。
# 相對路徑範例：DMS_STORAGE_ROOT=.\storage
# 完整路徑範例：DMS_STORAGE_ROOT=D:\DMS_FILES
DMS_STORAGE_ROOT=.\storage
# DMS_LEGACY_STORAGE_ROOT 用於讀取既有 dmsapi 儲存檔案；支援完整路徑與相對路徑，不需要相容舊資料時可留空。
# 完整路徑範例：DMS_LEGACY_STORAGE_ROOT=D:\DMS_LEGACY_FILES
DMS_LEGACY_STORAGE_ROOT=
SESSION_COOKIE_NAME=dms_session
SESSION_SECRET=A9228A44-EE18-4713-97C7-FC92A76CB27B
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false
